# SPDX-License-Identifier: GPL-2.0-only
# ============================================================================
# MolniyaOS Kernel Config Fragment for SDR/SATCOM Work
# ============================================================================
# This file is a "config fragment" — it only contains the options we want
# to CHANGE from the Pi 5 default config (bcm2712_defconfig).
#
# The merge_config.sh script handles dependency resolution. For example,
# enabling CONFIG_AX25 automatically pulls in CONFIG_HAMRADIO. We list
# both explicitly here for clarity, but the script would handle it either way.
#
# HOW TO READ THIS:
#   CONFIG_FOO=y     → compile into the kernel image (always available)
#   CONFIG_FOO=m     → compile as loadable module (load with modprobe)
#   # CONFIG_FOO is not set  → explicitly disable
#
# WHY =y vs =m?
#   =y (built-in): For things the system MUST have at boot time.
#     Like a default route — if it's not there when you need it, nothing works.
#   =m (module): For things you plug in later or use sometimes.
#     Like an ACL — loaded when you need to filter, not burning memory otherwise.
# ============================================================================


# =====================
# KERNEL NAME
# =====================
# Appends "-molniya" to the kernel version string, so `uname -r` reports
# something like 6.12.y-molniya+ instead of the stock 6.12.y-v8-16k+.
#
# This is not cosmetic. It does two things:
#   1. Modules install under a /lib/modules/ directory carrying "-molniya",
#      keeping them separate from the stock kernel's modules rather than
#      risking a collision with an identically-versioned stock kernel.
#   2. It makes "am I actually running my kernel?" answerable. Without it, a
#      stock 6.12 kernel and this one are indistinguishable from uname alone,
#      so a post-install check has nothing unambiguous to match on.
CONFIG_LOCALVERSION="-molniya"


# =====================
# SELF-DESCRIBING KERNEL
# =====================
# Embeds the full .config into the running kernel and exposes it at
# /proc/config.gz.
#
# Needed because the whole verification story depends on it. 02-post-install.sh
# reads /proc/config.gz to confirm the timer frequency, and without IKCONFIG
# that file does not exist -- so the check reported "unknown" no matter what was
# built. It also matters for the RT benchmark: proving the two kernels differ in
# exactly the ways claimed means being able to read each one's config back off
# the running system, rather than trusting the build log.
#
# Cost is a few hundred KB of compressed config in the image. Cheap for a
# kernel whose central claim needs to be auditable.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y


# =====================
# REAL-TIME SCHEDULING
# =====================
# This is the single most impactful change for SDR work.
#
# PREEMPT_RT turns Linux from a "general purpose OS that's pretty fast" into
# a "deterministic system that guarantees response times." Without it, if the
# kernel is in the middle of, say, flushing a disk buffer when your SDR
# delivers a sample, that sample waits. With RT, the SDR interrupt preempts
# the disk operation immediately.
#
# Analogy: Imagine a hospital ER with one doctor. Normal scheduling = the
# doctor finishes whatever they're doing before seeing the next patient,
# even if it's a heart attack. RT scheduling = heart attacks immediately
# interrupt non-critical work. Your SDR samples are the heart attacks.
#
CONFIG_PREEMPT_RT=y

# --- Timer Configuration ---
# HZ_1000: The kernel's internal metronome ticks 1000 times/second (every 1ms).
# At 250 Hz (default), the minimum scheduling granularity is 4ms — that's
# 9,600 missed samples at 2.4 Msps. At 1000 Hz, the worst case is 2,400.
# Combined with RT preemption, the actual latency is microseconds.
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# NO_HZ_FULL: "Tickless" mode. When only one task is running (your SDR
# processing thread), the kernel stops generating timer interrupts entirely.
# Zero overhead. It's like disabling keepalive probes on a known-good link —
# why interrupt the data flow to ask "are you still there?"
CONFIG_NO_HZ_FULL=y

# HIGH_RES_TIMERS: Enables nanosecond-precision timers instead of the
# default jiffy-based (1ms) timers. SDR timing often needs sub-millisecond
# precision for things like Doppler correction and burst synchronization.
CONFIG_HIGH_RES_TIMERS=y


# =====================
# CPU PERFORMANCE
# =====================
# Force the CPU to always run at maximum frequency.
# The Pi 5's Cortex-A76 can scale from 1.5 GHz to 2.4 GHz. With the
# "ondemand" governor (default), it lounges at 1.5 GHz until load spikes,
# then ramps up — but that ramp takes milliseconds, during which your
# SDR sample buffer can overflow. "Performance" governor = always 2.4 GHz.
#
# The tradeoff: more power draw and heat. For a Pi on a desk with adequate
# cooling, this is fine. For field work on battery, you might swap this
# to "ondemand" and accept occasional sample drops.
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y


# =====================
# USB SUBSYSTEM
# =====================
# The RTL-SDR and HackRF both connect over USB. These must be solid.
# Built-in (=y) because USB must work before any modules can load.
#
# The Pi 5 has a new USB architecture: the RP1 I/O chip handles USB 2.0,
# and there's a PCIe-attached xHCI controller for USB 3.0. We need both.
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_DWCOTG=y


# =====================
# SDR HARDWARE SUPPORT
# =====================
# These are the kernel drivers for the actual SDR chipsets.
# Modules (=m) because you plug the SDR in after boot.
#
# THE DRIVER STACK (from bottom to top, like a network stack):
#
#   Physical chip:   RTL2832U (USB interface + ADC)
#                    ↓
#   Tuner chip:      R820T2 (selects frequency, like tuning a radio dial)
#                    ↓
#   Kernel driver:   dvb_usb_rtl28xxu → presents as media device
#                    ↓
#   SDR driver:      rtl2832_sdr → presents as SDR (raw I/Q mode)
#                    ↓
#   Userspace:       librtlsdr talks to /dev/swradio0
#
# NOTE: Even though we compile the DVB-T driver as a module here, we'll
# BLACKLIST it in userspace so it doesn't auto-load and steal the device
# from the SDR driver. We compile it because some tools can optionally
# use DVB mode, and having the module available but not auto-loaded gives
# us flexibility.

# Media subsystem (parent framework for all TV/radio/camera drivers)
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_MEDIA_SDR_SUPPORT=y

# RTL2832 SDR mode — this is the actual driver you want
CONFIG_DVB_RTL2832_SDR=m

# RTL2832 DVB-T mode — compiled but will be blacklisted
CONFIG_DVB_USB_RTL28XXU=m
CONFIG_DVB_RTL2832=m

# R820T/R820T2 tuner — the frequency selection chip
# This is like the channel selector on a TV. The RTL2832 digitizes
# whatever frequency the R820T is tuned to.
CONFIG_MEDIA_TUNER_R820T=m

# HackRF support (for when you upgrade)
# HackRF uses a different path — it appears as a USB device and is
# handled entirely in userspace by libhackrf. No kernel driver needed
# beyond basic USB. But enabling CONFIG_USB_GADGET gives flexibility
# for HackRF's TX mode.


# =====================
# AMATEUR RADIO / AX.25 / PACKET
# =====================
# This is the networking-over-radio stack. The kernel treats radio links
# as network interfaces, just like Ethernet or WiFi.
#
# THE AX.25 STACK (mapped to what you know):
#
#   AX.25           ≈  Ethernet + IP combined for ham radio
#   ├── Connected   ≈  TCP (reliable, ordered, ACK'd)
#   ├── UI frames   ≈  UDP (connectionless, used for APRS beacons)
#   ├── NET/ROM     ≈  OSPF-like routing layer between AX.25 nodes
#   └── ROSE        ≈  X.25 WAN routing (longer-distance, switched)
#
# KISS / 6PACK are serial protocols for talking to a TNC (Terminal Node
# Controller — a hardware modem for radio, like an external DSL modem).
# Software TNCs like direwolf replace the hardware, but the kernel
# interface is the same.
#
# Once loaded, you get a real network interface:
#   $ sudo kissattach /dev/ttyUSB0 ax0
#   $ ifconfig ax0
#   ax0: flags=67<UP,BROADCAST,RUNNING>  mtu 256
#         ax25 N0CALL-0
#
# Yes, you can run IP over AX.25. You can literally ping another ham
# radio station over RF using the kernel's standard networking stack.

CONFIG_HAMRADIO=y
CONFIG_AX25=m
CONFIG_AX25_DAMA_SLAVE=y
CONFIG_NETROM=m
CONFIG_ROSE=m

# Serial line disciplines for TNC communication
CONFIG_MKISS=m
CONFIG_6PACK=m

# Software modem support (used by direwolf and soundmodem)
# SLIP is Serial Line IP — the simplest way to run IP over a serial link.
# It's the ancestor of PPP and is still used for AX.25-over-serial.
CONFIG_SLIP=m
CONFIG_SLIP_COMPRESSED=y


# =====================
# NETWORKING (keep for homelab integration)
# =====================
# You already know this stack from CCNA studies. These modules let
# your Pi integrate with your existing network infrastructure.

CONFIG_NETFILTER=y
CONFIG_BRIDGE=m
CONFIG_VLAN_8021Q=m

# TUN/TAP: Virtual network interfaces. GNU Radio and some SDR tools
# create TUN devices to pipe decoded packets into the network stack.
# It's how your decoded AX.25 packets enter the normal IP routing table.
CONFIG_TUN=m

# WireGuard: For encrypting remote SDR sessions. When you SSH into
# your field Pi over cellular, WireGuard tunnels keep your SDR data
# and commands private. Lightweight and fast — much less CPU overhead
# than OpenVPN, which matters on a battery-powered Pi.
CONFIG_WIREGUARD=m


# =====================
# Pi 5 SPECIFIC HARDWARE
# =====================
# These should already be set by bcm2712_defconfig, but we list them
# explicitly to make sure they survive our config merge.
#
# RP1 is the Pi 5's new I/O controller chip — it handles GPIO, SPI,
# I2C, UART, USB 2.0, and Ethernet. Without these drivers, the Pi 5
# is basically a brick with a CPU. Think of RP1 as a southbridge chip
# on a PC motherboard — it bridges the CPU to all the low-speed I/O.

CONFIG_BCM2835_MBOX=y
CONFIG_RASPBERRYPI_FIRMWARE=y
CONFIG_GPIO_BCM_VIRT=y
CONFIG_PINCTRL_BCM2835=y


# =====================
# REQUIRED BY A/B UPDATES (Phase 4d)
# =====================
# Setting the tryboot flag goes through vcmailbox via /dev/vcio. That char
# driver is NOT upstream - it only exists in the Pi kernel tree. Building from
# the RPi fork means we have it, but "have it by inheritance" and "pinned" are
# different things: this is the single kernel option the entire rollback
# mechanism rests on, so it gets named here rather than assumed.
#
# VERIFIED 2026-08-23 against /proc/config.gz on pi-server, running the MolniyaOS
# kernel. The symbol is CONFIG_BCM_VCIO. The name guessed here before,
# CONFIG_BCM2835_VCIO, does not exist in the Pi tree at all -- and since
# merge_config.sh does not fail on an unknown symbol, that line was a silent
# no-op. /dev/vcio was present on the box regardless, inherited from the Pi
# defconfig, so the wrong pin still looked like it was working. A pin that
# cannot fail is not a pin, which is why this symbol is now gated in
# verify_critical_config() too rather than trusted to a merge that will not
# complain.
CONFIG_BCM_VCIO=y

# Hardware watchdog. A/B rollback covers "booted but broken"; it cannot cover a
# hang. The watchdog is what turns a hang into a reset (systemd arms it with
# RuntimeWatchdogSec). Like a dead-man switch on a train: if nothing checks in,
# the system stops itself rather than sitting there wedged.
#
# VERIFIED 2026-08-23: the driver binds on BCM2712. /sys/class/watchdog/watchdog0
# reads "Broadcom BCM2835 Watchdog timer", state active, timeout 60, bootstatus
# 0. It is also already armed, by Raspberry Pi OS and not by MolniyaOS --
# /usr/lib/systemd/system.conf.d/40-rpi-enable-watchdog.conf sets
# RuntimeWatchdogSec=1m, and PID 1 holds the device. Inherited behaviour, which
# an image built from something other than Pi OS would drop. See ROADMAP 4d.
CONFIG_BCM2835_WDT=y


# =====================
# STRIP UNNECESSARY SUBSYSTEMS
# =====================
# Everything below is dead weight for an SDR workstation.
# Disabling these saves:
#   - Build time (fewer modules to compile)
#   - Memory at runtime (fewer modules loaded)
#   - Attack surface (fewer drivers = fewer potential vulnerabilities —
#     same reason you disable unused services on a firewall)

# GPU drivers we'll never use (Pi uses VideoCore, not these)
# CONFIG_DRM_I915 is not set
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_RADEON is not set
# CONFIG_DRM_NOUVEAU is not set

# High-performance computing interconnects (server-grade, not Pi)
# CONFIG_INFINIBAND is not set

# Legacy telecom (ISDN is 1990s digital phone lines)
# CONFIG_ISDN is not set

# NFC (near-field communication — tap-to-pay, not RF analysis)
# CONFIG_NFC is not set

# Bluetooth — disable unless you plan to sniff BLE
# If you want BLE sniffing later, re-enable as module
# CONFIG_BT is not set

# Joysticks, touchscreens, tablets
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TABLET is not set
# CONFIG_INPUT_TOUCHSCREEN is not set

# Accessibility features
# CONFIG_ACCESSIBILITY is not set
